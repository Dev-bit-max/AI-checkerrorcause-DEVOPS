            "exec": [
              "pm.test(\"Status code is 200 OK\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response is an array of incidents\", () => {\r",
              "    const responseData = pm.response.json();\r",
