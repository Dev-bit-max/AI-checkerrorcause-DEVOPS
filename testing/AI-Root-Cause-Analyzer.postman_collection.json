    {
      "name": "Get Incident Report by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Report contains root cause and recommendation\", () => {\r",
              "    const report = pm.response.json();\r",
              "    pm.expect(report).to.have.property(\"id\");\r",
              "    pm.expect(report).to.have.property(\"rootCause\");\r",
